# ============================================================================
# Court Ecosystem Backend Environment Configuration
# ============================================================================
# Copy this file to .env and update values for your environment
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:7L%ws8JQzpi6Mc*@db.tvcxhspsgxmlzafovcpi.supabase.co:5432/postgres

# SQLAlchemy configuration
SQLALCHEMY_TRACK_MODIFICATIONS=False

# ============================================================================
# REAL-TIME SCRAPING CONFIGURATION
# ============================================================================

# Enable/disable official eCourts portal scraping
# Set to 'true' for official portals, 'false' to use only legacy scrapers
USE_ECOURTS_PORTAL=true

# Real-time polling interval in minutes (5-15 recommended)
# Determines how frequently the system polls for new cases
# 5 = every 5 minutes (high freshness, high load)
# 10 = every 10 minutes (recommended balance)
# 15 = every 15 minutes (lower load, slight delay)
SCRAPER_POLLING_INTERVAL_MINUTES=10

# Historical lookback window in hours for real-time scraping
# How far back to search for new cases in each poll
# 24 = look back 24 hours (recommended for real-time)
# 48 = look back 48 hours (more comprehensive)
SCRAPER_LOOKBACK_HOURS=24

# ============================================================================
# RATE LIMITING & ETHICAL SCRAPING
# ============================================================================

# Rate limiting: pause between requests to official portals (seconds)
# Set per IP - respects server load
# 30 = 1 request per 30 seconds (gentle)
# 60 = 1 request per minute (standard, recommended)
# 120 = 1 request per 2 minutes (very conservative)
SCRAPER_RATE_LIMIT_SECONDS=60

# ============================================================================
# PROXY CONFIGURATION (Optional)
# ============================================================================
# For large-scale scraping, use rotating proxies to avoid IP blocking
# Format: comma-separated list of proxy URLs
# Example: http://proxy1.com:8080,http://proxy2.com:8080,socks5://proxy3.com:1080
# Leave empty to use direct connection (recommended for official gov sites)
PROXY_LIST=

# ============================================================================
# ECOURTS PORTAL-SPECIFIC CONFIGURATION
# ============================================================================

# High Court Services Portal (hcservices.ecourts.gov.in)
# State for High Court filters (e.g., Delhi, Maharashtra, Karnataka)
ECOURTS_HC_STATE=all

# District Courts Portal Configuration
# Default district to scrape (e.g., bengaluru, delhi, mumbai)
# Will be used if no specific district is configured
ECOURTS_DEFAULT_DISTRICT=all

# NJDG (National Judicial Data Grid) Configuration
# State filter for NJDG queries
NJDG_STATE=all

# District filter for NJDG queries
NJDG_DISTRICT=all

# Maximum results per NJDG search query
NJDG_MAX_RESULTS=100

# ============================================================================
# LEGACY SCRAPER CONFIGURATION (Indian Kanoon / AIR Online)
# ============================================================================

# Enabled scraper sources (comma-separated)
# Options: air (AIR Online), ik (Indian Kanoon)
# Default: air,ik (use both)
SCRAPER_SOURCES=air,ik

# Enable/disable Indian Kanoon backfill scraping
IK_ENABLE_BACKFILL=true

# Maximum cases to fetch per Indian Kanoon search
IK_MAX_CASES_PER_COURT=120

# Maximum search results from Indian Kanoon
IK_SEARCH_MAX_RESULTS=100

# Search query template for Indian Kanoon
# {court} will be replaced with the court name
IK_SEARCH_QUERY_TEMPLATE="{court}"

# Maximum cases from AIR Online per court
AIR_MAX_CASES_PER_COURT=0

# AIR authentication
AIR_AUTH_MAX_PAGES=1
AIR_SESSION_COOKIE=
AIR_AUTH_SEARCH_URL=https://www.aironline.in/search

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# API CONFIGURATION
# ============================================================================

# API host and port
API_HOST=0.0.0.0
API_PORT=8000

# CORS settings
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Secret key for API security
SECRET_KEY=court-ecosystem-secret-key-2026

# ============================================================================
# DOCUMENT STORAGE CONFIGURATION
# ============================================================================

# Directory for storing downloaded PDFs
DOCUMENTS_DIR=./documents

# Maximum PDF file size in MB
MAX_PDF_SIZE_MB=50

# ============================================================================
# MONITORING & HEALTH CHECKS
# ============================================================================

# Environment name (development, staging, production)
ENVIRONMENT=development

# Debug mode
DEBUG=true

# Enable detailed scraping logs
VERBOSE_SCRAPING=false

# Slack webhook for error notifications (optional)
SLACK_WEBHOOK_URL=

# Email for error notifications (optional)
ERROR_EMAIL=

# ============================================================================
# WEBSOCKET CONFIGURATION
# ============================================================================

# WebSocket keep-alive ping interval (seconds)
WS_PING_INTERVAL=30

# WebSocket connection timeout (seconds)
WS_CONNECTION_TIMEOUT=60

# ============================================================================
# NOTES
# ============================================================================
# 1. For official eCourts portals:
#    - Respect robots.txt (mostly allowed for automated aggregators)
#    - Use SCRAPER_RATE_LIMIT_SECONDS=60 minimum
#    - Do NOT use proxies for government sites (may cause blocking)
#    - Portals: hcservices.ecourts.gov.in, district.dcourts.gov.in, njdg.ecourts.gov.in
#
# 2. For real-time case detection:
#    - SCRAPER_POLLING_INTERVAL_MINUTES: 5-15 minutes recommended
#    - SCRAPER_LOOKBACK_HOURS: Match your polling interval for no gaps
#    - CNR (Case Number Record) is primary key for deduplication
#
# 3. For concurrent scraping of multiple courts:
#    - Increase SCRAPER_LOOKBACK_HOURS for broader coverage
#    - Adjust SCRAPER_POLLING_INTERVAL_MINUTES based on server capacity
#    - Monitor database growth and archive old data regularly
#
# 4. WebSocket real-time updates:
#    - Automatically broadcast new cases when detected
#    - Clients subscribe to case types/courts via WebSocket (/api/ws/ws/{client_id})
#    - Ensure WS_PING_INTERVAL < WS_CONNECTION_TIMEOUT
#    - Useful for: dashboards, mobile apps, live notifications
#
# 5. Database:
#    - Ensure PostgreSQL is running and accessible
#    - Run migrations after deploying schema changes
#    - Regular backups recommended for production
#    - New columns: cnr, is_new, first_detected_at in cases table
