# Court Ecosystem Configuration - Copy this to .env and fill in values

# ===========================
# DATABASE CONFIGURATION
# ===========================
# For local development with SQLite:
DATABASE_URL=sqlite:////Volumes/PortableSSD/court-ecosystem/data/court_ecosystem.db

# For PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://username:password@localhost:5432/court_ecosystem

# ===========================
# AUTHENTICATION & SECURITY
# ===========================
SECRET_KEY=your-secret-key-change-this-in-production
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ===========================
# API CONFIGURATION
# ===========================
API_BASE_URL=http://localhost:8000
# For production/Vercel:
# API_BASE_URL=https://your-backend-api.com

# ===========================
# FRONTEND CONFIGURATION
# ===========================
FRONTEND_URL=http://localhost:3000
# For production/Vercel:
# FRONTEND_URL=https://your-frontend.vercel.app

# ===========================
# SCRAPER SETTINGS
# ===========================
SCRAPER_ENABLED=true
USE_ECOURTS_PORTAL=true
SCRAPER_POLLING_INTERVAL_MINUTES=10
SCRAPER_LOOKBACK_HOURS=24
SCRAPER_RATE_LIMIT_SECONDS=60

# ===========================
# PROXY CONFIGURATION
# ===========================
# Leave empty for direct connection
PROXY_LIST=

# ===========================
# DISTRICT FOCUS
# ===========================
DISTRICT_FOCUS=Bengaluru

# ===========================
# LOGGING
# ===========================
LOG_LEVEL=INFO

# ===========================
# SUPABASE (Optional - for cloud sync)
# ===========================
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# ===========================
# SQLALCHEMY
# ===========================
SQLALCHEMY_TRACK_MODIFICATIONS=False
DEBUG=False
